# === AI 요약 인증: OAuth 방식 ===
#
# [로컬] 이 파일이 없어도 됩니다.
#   Node.js + Claude Code CLI 설치 후 `claude` 로그인만 하면,
#   report.py 가 로그인 세션(OAuth)을 그대로 사용합니다.
#
# [CI / GitHub Actions] 아래 토큰을 Actions Secret 으로 등록하세요.
#   발급:  claude setup-token   (브라우저 OAuth → 장기 토큰 1회 출력)
#   Secret 이름: CLAUDE_CODE_OAUTH_TOKEN
#
# 로컬에서 굳이 토큰으로 쓰고 싶을 때만 아래를 .env 로 복사해 채우세요(커밋 금지).
CLAUDE_CODE_OAUTH_TOKEN=

# === 텔레그램 발송 (선택) ===
#
# 오늘자 Daily Brief를 텔레그램으로 자동 발송합니다. 없으면 발송만 스킵됩니다.
#
# 1) @BotFather 에게 /newbot → 봇 생성 후 토큰 발급 → TELEGRAM_BOT_TOKEN
# 2) 만든 봇과 대화창에서 아무 메시지나 보낸 뒤,
#    https://api.telegram.org/bot<토큰>/getUpdates 를 열어 chat.id 확인 → TELEGRAM_CHAT_ID
#    (그룹/채널로 보내려면 봇을 그룹에 넣고 그 chat.id 사용)
# 3) [CI] 위 두 값을 GitHub Settings → Secrets → Actions 에 등록
#        (선택) SITE_URL 은 Settings → Variables 에 리포트 주소로 등록
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_URL=
